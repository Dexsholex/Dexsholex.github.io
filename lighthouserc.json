{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "url": [
        "http://localhost/",
        "http://localhost/services/eudr-compliance/",
        "http://localhost/work/oil-palm-tree-counting/",
        "http://localhost/fr/",
        "http://localhost/pt/work/geoaid-flood-susceptibility/",
        "http://localhost/es/services/",
        "http://localhost/ar/",
        "http://localhost/ar/data-protection/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.9}],
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.95}],
        "categories:seo": ["error", {"minScore": 0.95}]
      }
    }
  }
}
